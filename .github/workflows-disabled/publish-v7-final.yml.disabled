name: PetriCoach V7 Finalveroeffentlichung

on:
  push:
    branches: [main]
    paths:
      - '.github/workflows/publish-v7-final.yml'
      - 'v7-final-trigger.txt'
  workflow_dispatch:

concurrency:
  group: petricoach-v7-final
  cancel-in-progress: true

permissions:
  contents: write
  pages: read

env:
  PUBLIC_URL: https://mrplaymeon-png.github.io/v7/

jobs:
  build-test-publish:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - name: Repository laden
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Node einrichten
        uses: actions/setup-node@v4
        with:
          node-version: '24'

      - name: V7 mit echten Lernfotos bauen
        run: node tools/build-v7-real-images.mjs

      - name: Vollstaendigkeit und Bildqualitaet pruefen
        run: |
          test -f v7/index.html
          test -f v7/real-images.js
          test -f v7/real-images.css
          test -f v7/sw.js
          test -f v7/build-report.json
          node - <<'NODE'
          const fs=require('fs');
          const report=JSON.parse(fs.readFileSync('v7/build-report.json','utf8'));
          const expected={questions:180,species:49,practice:10,components:12};
          for(const [key,value] of Object.entries(expected)){
            if(report[key]!==value) throw new Error(`${key}: ${report[key]} statt ${value}`);
          }
          if(report.logicalPhotoAssignments<190) throw new Error(`Zu wenige Fotozuordnungen: ${report.logicalPhotoAssignments}`);
          if(report.uniquePhotoFiles<75) throw new Error(`Zu wenige unterschiedliche echte Fotos: ${report.uniquePhotoFiles}`);
          if(report.totalPhotoBytes<1500000) throw new Error(`Fotodaten zu klein: ${report.totalPhotoBytes}`);
          if(!Array.isArray(report.sources)||report.sources.length!==report.logicalPhotoAssignments) throw new Error('Fotoquellen unvollstaendig');
          for(const source of report.sources){
            if(!source.file||!source.source||!source.license) throw new Error(`Quellenangabe fehlt: ${source.kind}/${source.key}`);
          }
          const html=fs.readFileSync('v7/index.html','utf8');
          const js=fs.readFileSync('v7/real-images.js','utf8');
          if(!html.includes('real-images.js?v=7.1.0')) throw new Error('Version-7.1-Skript fehlt');
          if(!js.includes('Echtes Lernfoto')) throw new Error('Fotoeinblendung fehlt');
          if(/Failed to Decode Data|DecompressionStream/.test(html)) throw new Error('Alte fehlerhafte Ladefunktion gefunden');
          console.log(JSON.stringify({status:'static-pass',...expected,assignments:report.logicalPhotoAssignments,uniquePhotos:report.uniquePhotoFiles,photoBytes:report.totalPhotoBytes,fallbacks:report.fallbackAssignments.length},null,2));
          NODE

      - name: Mobilen Browser installieren
        run: |
          npm install --no-save playwright@1.55.0
          npx playwright install --with-deps chromium

      - name: Lokalen Webserver starten
        run: |
          python3 -m http.server 4173 > /tmp/petricoach-v7-server.log 2>&1 &
          echo $! > /tmp/petricoach-v7-server.pid
          for i in $(seq 1 30); do
            if curl -fsS http://127.0.0.1:4173/v7/ >/dev/null; then exit 0; fi
            sleep 1
          done
          cat /tmp/petricoach-v7-server.log
          exit 1

      - name: V7 lokal wie auf einem iPhone bedienen
        env:
          TEST_URL: http://127.0.0.1:4173/v7/
          TEST_REPORT: v7/local-test.json
          TEST_SCREENSHOT: v7/mobile-test.png
        run: node tools/test-v7.mjs

      - name: Lokalen Mobiltest validieren
        run: |
          node - <<'NODE'
          const report=require('./v7/local-test.json');
          if(report.status!=='passed') throw new Error(JSON.stringify(report));
          if(!report.realPhotoVisible) throw new Error('Echtes Foto im Lernmodus nicht sichtbar');
          if(report.pageErrors?.length) throw new Error(`Browserfehler: ${report.pageErrors.join('; ')}`);
          if(report.failedRequests?.length) throw new Error(`Fehlgeschlagene App-Abrufe: ${report.failedRequests.join('; ')}`);
          console.log(JSON.stringify(report,null,2));
          NODE

      - name: V7 in das Repository schreiben
        id: publish
        run: |
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add -A v7
          if ! git diff --cached --quiet; then
            git commit -m 'PetriCoach V7 mit echten Lernfotos veroeffentlichen'
          fi
          for attempt in 1 2 3 4 5; do
            git pull --rebase origin main
            if git push origin main; then break; fi
            if [ "$attempt" = "5" ]; then exit 1; fi
            sleep $((attempt * 3))
          done
          echo "sha=$(git rev-parse HEAD)" >> "$GITHUB_OUTPUT"

      - name: Auf GitHub Pages warten
        env:
          BUILD_SHA: ${{ steps.publish.outputs.sha }}
        run: |
          FOUND=0
          for i in $(seq 1 90); do
            BODY=$(curl -fsSL "${PUBLIC_URL}?build=${BUILD_SHA}&attempt=${i}" 2>/dev/null || true)
            if printf '%s' "$BODY" | grep -q 'real-images.js?v=7.1.0'; then
              FOUND=1
              echo 'Oeffentliche V7.1 ist verfuegbar.'
              break
            fi
            sleep 8
          done
          if [ "$FOUND" != "1" ]; then
            echo 'Die oeffentliche V7.1 erschien nicht rechtzeitig.'
            exit 1
          fi

      - name: Oeffentliche V7 wie auf einem iPhone bedienen
        env:
          TEST_URL: ${{ env.PUBLIC_URL }}?build=${{ steps.publish.outputs.sha }}
          TEST_REPORT: /tmp/live-test.json
          TEST_SCREENSHOT: /tmp/live-mobile-test.png
        run: node tools/test-v7.mjs

      - name: Live-Test validieren und Hauptadresse umstellen
        env:
          BUILD_SHA: ${{ steps.publish.outputs.sha }}
        run: |
          node - <<'NODE'
          const fs=require('fs');
          const live=JSON.parse(fs.readFileSync('/tmp/live-test.json','utf8'));
          if(live.status!=='passed'||!live.realPhotoVisible) throw new Error(`Live-Test fehlgeschlagen: ${JSON.stringify(live)}`);
          if(live.pageErrors?.length||live.failedRequests?.length) throw new Error(`Live-Browserfehler: ${JSON.stringify(live)}`);
          const build=JSON.parse(fs.readFileSync('v7/build-report.json','utf8'));
          fs.copyFileSync('/tmp/live-test.json','v7/live-test.json');
          fs.copyFileSync('/tmp/live-mobile-test.png','v7/live-mobile-test.png');
          fs.writeFileSync('v7/final-release.json',JSON.stringify({status:'passed',version:build.version,builtFrom:process.env.BUILD_SHA,questions:build.questions,species:build.species,practice:build.practice,components:build.components,logicalPhotoAssignments:build.logicalPhotoAssignments,uniquePhotoFiles:build.uniquePhotoFiles,totalPhotoBytes:build.totalPhotoBytes,fallbackAssignments:build.fallbackAssignments.length,liveTest:live},null,2));
          NODE
          cat > index.html <<'HTML'
          <!doctype html>
          <html lang="de">
          <head>
            <meta charset="utf-8">
            <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
            <meta name="theme-color" content="#073b46">
            <meta name="apple-mobile-web-app-capable" content="yes">
            <meta name="apple-mobile-web-app-title" content="PetriCoach NRW">
            <meta http-equiv="refresh" content="0;url=/v7/">
            <title>PetriCoach NRW</title>
            <style>html,body{margin:0;min-height:100%;display:grid;place-items:center;background:#06191e;color:#f6fbfc;font:18px -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}a{color:#75e1e8}</style>
          </head>
          <body><p>PetriCoach mit echten Lernfotos wird geoeffnet …<br><a href="/v7/">App direkt oeffnen</a></p><script>location.replace('/v7/'+location.search+location.hash)</script></body>
          </html>
          HTML
          cat > manifest.webmanifest <<'JSON'
          {
            "name": "PetriCoach NRW – Angelscheintrainer mit echten Lernfotos",
            "short_name": "PetriCoach",
            "description": "Bebilderter Intensivtrainer fuer die Fischerpruefung in Nordrhein-Westfalen.",
            "lang": "de-DE",
            "start_url": "/v7/",
            "scope": "/v7/",
            "display": "standalone",
            "orientation": "portrait-primary",
            "background_color": "#06191e",
            "theme_color": "#073b46",
            "icons": [{"src":"/v7/icon.svg","sizes":"any","type":"image/svg+xml","purpose":"any maskable"}]
          }
          JSON
          cat > sw.js <<'JS'
          const OLD=['petricoach-nrw-v3-1','petricoach-nrw-v3-2-1','petricoach-root-redirect-v6'];
          self.addEventListener('install',event=>event.waitUntil(self.skipWaiting()));
          self.addEventListener('activate',event=>event.waitUntil(Promise.all(OLD.map(name=>caches.delete(name))).then(()=>self.clients.claim())));
          self.addEventListener('fetch',event=>{if(event.request.method!=='GET')return;if(event.request.mode==='navigate')event.respondWith(fetch(event.request,{cache:'no-store'}).catch(()=>Response.redirect('/v7/',302)));});
          JS
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add index.html manifest.webmanifest sw.js v7/live-test.json v7/live-mobile-test.png v7/final-release.json
          git commit -m 'Gepruefte PetriCoach V7.1 als Hauptversion aktivieren'
          for attempt in 1 2 3 4 5; do
            git pull --rebase origin main
            if git push origin main; then break; fi
            if [ "$attempt" = "5" ]; then exit 1; fi
            sleep $((attempt * 3))
          done

      - name: Abschlussbericht
        run: cat v7/final-release.json
