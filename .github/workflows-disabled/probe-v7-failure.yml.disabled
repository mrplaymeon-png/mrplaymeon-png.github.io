name: V7-Fehlerprotokollprobe

on:
  push:
    branches: [main]
    paths:
      - '.github/workflows/probe-v7-failure.yml'
  workflow_dispatch:

permissions:
  actions: read
  contents: write

jobs:
  probe:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Fehlerprotokoll laden
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          JOB_ID: '89806101673'
        run: |
          mkdir -p v7
          curl -fsSL \
            -H "Accept: application/vnd.github+json" \
            -H "Authorization: Bearer ${GH_TOKEN}" \
            -H "X-GitHub-Api-Version: 2022-11-28" \
            "https://api.github.com/repos/${REPO}/actions/jobs/${JOB_ID}/logs" \
            -o /tmp/job.log
          tail -n 220 /tmp/job.log > v7/previous-build-failure.log
      - name: Ergebnis speichern
        run: |
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add v7/previous-build-failure.log
          git commit -m 'Vorherigen V7-Buildfehler speichern'
          git pull --rebase origin main
          git push origin main
